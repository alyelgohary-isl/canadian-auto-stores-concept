---
import { site, type NavKey } from "../site.config";
import { url } from "../lib/url";

interface Props {
  /** Nav item marked aria-current="page" */
  current?: NavKey;
}
const { current } = Astro.props;
const [first, second] = site.brand;
/* an external CTA (the online catalogue) opens in a new tab */
const ext = /^https?:/.test(site.cta.href) ? { target: "_blank", rel: "noopener" } : {};
---
<header class="site-header">
  <a class="brand" href={url()}>{first}<em>{second}</em></a>
  <nav class="site-nav" id="site-nav" aria-label="Primary">
    {site.nav.map((item) => (
      <a href={url(item.href)} aria-current={item.key === current ? "page" : undefined}>{item.label}</a>
    ))}
    <a class="header-cta" href={url(site.cta.href)} {...ext}>{site.cta.label}</a>
  </nav>
  <div class="header-right">
    <a class="header-cta" href={url(site.cta.href)} {...ext}>{site.cta.label}</a>
    <button class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="site-nav"><span></span></button>
  </div>
</header>
